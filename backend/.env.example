# Database
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/tms_dev"

# JWT
# Access token signing secret — use a random 256-bit string, NEVER commit the real value
JWT_SECRET="change-me-to-a-random-256-bit-secret-at-least-32-chars"
# Refresh token signing secret — MUST be different from JWT_SECRET
JWT_REFRESH_SECRET="change-me-to-a-different-random-256-bit-secret-32-chars"

# Server
PORT=4000
NODE_ENV=development

# CORS — frontend origin allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# File Storage — local uploads directory path
UPLOAD_DIR="./uploads"

# AI — Google Gemini API key (uses gemini-2.5-flash model)
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# AI — Anthropic Claude API key (optional, not used if Gemini is set)
ANTHROPIC_API_KEY=""
