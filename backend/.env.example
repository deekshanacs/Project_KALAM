# ── Railway Backend Environment Variables ─────────────────────────────────────
# Set these in your Railway service → Variables tab

# PostgreSQL — Railway provides this automatically when you add a PostgreSQL plugin
# It will be injected as DATABASE_URL automatically. No need to set it manually.
# DATABASE_URL="postgresql://user:password@host.railway.internal:5432/railway"

# JWT — generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET="replace-with-64-char-random-string"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-string"

# Server
PORT=4000
NODE_ENV=production

# CORS — your deployed Vercel frontend URL (set after Vercel deploy)
CORS_ORIGIN="https://your-app.vercel.app"

# Public backend URL — your Railway service URL (set after Railway deploy)
PUBLIC_URL="https://your-app.up.railway.app"

# File storage
UPLOAD_DIR="./uploads"

# AI — Google Gemini (optional)
GEMINI_API_KEY="your-gemini-api-key"

# AI — Anthropic (optional)
ANTHROPIC_API_KEY=""
