# ── Render Backend Environment Variables ──────────────────────────────────────
# Copy these to your Render Web Service environment settings

# PostgreSQL (Neon) — get from Neon dashboard
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# JWT — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-64-char-random-string"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-string"

# Server
PORT=4000
NODE_ENV=production

# CORS — your deployed frontend URL
CORS_ORIGIN="https://project-kalam-frontend.onrender.com"

# Public backend URL used in generated links and file serving
PUBLIC_URL="https://project-kalam-backend.onrender.com"

# File storage (ephemeral on Render free tier)
UPLOAD_DIR="./uploads"

# AI — Google Gemini
GEMINI_API_KEY="your-gemini-api-key"

# AI — Anthropic (optional)
ANTHROPIC_API_KEY=""
