# ── Copy this to .env and fill in real values ──

# Database (Neon / Render PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT secrets — use long random strings, keep different from each other
JWT_SECRET="change-me-to-a-random-256-bit-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-random-256-bit-secret-32-chars"

# Server
PORT=4000
NODE_ENV=production

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN="https://project-kalam-frontend.onrender.com"

# File Storage
UPLOAD_DIR="./uploads"

# Public URL for file serving (your Render backend URL)
PUBLIC_URL="https://project-kalam-backend.onrender.com"

# AI — Google Gemini API key
GEMINI_API_KEY="your-gemini-api-key-here"

# AI — Anthropic (optional)
ANTHROPIC_API_KEY=""
