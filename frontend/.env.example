# ── Vercel Frontend Environment Variables ─────────────────────────────────────
# Set these in your Vercel project → Settings → Environment Variables

# Backend API URL — Railway service URL
VITE_API_URL=https://project-kalam-backend-production.up.railway.app

# Socket.io URL — same as API URL
VITE_SOCKET_URL=https://project-kalam-backend-production.up.railway.app
